@{
    ViewData["Title"] = "Book Already Returned";
    var msg = TempData["ErrorMessage"] as string;
}

<div class="container text-center mt-5">
    <h1 class="display-3 text-info">Book Already Returned</h1>
    <p class="lead">
        @(string.IsNullOrEmpty(msg) ? "The borrow record has already been returned." : msg)
    </p>
    <a asp-action="Index" asp-controller="Books" class="btn btn-primary">Back to Book List</a>
</div>