@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Delete book";
}

<h1>Delete book</h1>
<h3 class="text-danger">Are you sure you want to delete this book?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Title)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Author)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Author)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ISBN)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.ISBN)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>