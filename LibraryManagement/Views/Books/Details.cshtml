@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Book details";
}

<h1>Book details</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Title)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Author)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Author)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ISBN)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.ISBN)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.PublishedDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.PublishedDate)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IsAvailable)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.IsAvailable)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to list</a>